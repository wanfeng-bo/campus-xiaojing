# School Facts Writer Executor 独占。复制为 .env.school-fact-writer；不得注入 API。
SCHOOL_FACT_WRITER_DATABASE_HOST=postgres
SCHOOL_FACT_WRITER_DATABASE_PORT=5432
SCHOOL_FACT_WRITER_DATABASE_NAME=campus_ai_internal
SCHOOL_FACT_WRITER_DATABASE_USER=campus_ai_school_fact_writer
SCHOOL_FACT_WRITER_DATABASE_PASSWORD=change-me-writer-database-password-0001
SCHOOL_FACT_WRITER_EXPECTED_ANCHOR_ID=11111111-1111-4111-8111-111111111111
SCHOOL_FACT_WRITER_EXPECTED_SCHOOL_ID=22222222-2222-4222-8222-222222222222
SCHOOL_FACT_WRITER_EXPECTED_SYSTEM_IDENTIFIER=0000000000000000000
SCHOOL_FACT_WRITER_CONFIRMATION_HMAC_KEY=change-me-writer-confirmation-hmac-key-0001
SCHOOL_FACT_WRITER_CALLER_AUTH_KEY=change-me-executor-caller-auth-key-0001
SCHOOL_FACT_WRITER_CONTEXT_TRANSPORT_HMAC_KEY=change-me-executor-context-transport-key-0001
SCHOOL_FACT_WRITER_RLS_CONTEXT_SIGNING_KEY=change-me-shared-rls-context-signing-key-0001
