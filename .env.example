# 应用
APP_ENV=development
API_PORT=8000
WEB_PORT=5173

# PostgreSQL
# 仅空 PostgreSQL 卷会自动创建受控隔离角色。
# 已有卷不得只替换本文件后启动；必须先按后续受控 runbook 补做角色迁移。
# Database control credentials live in .env.local-database-control, never the API env.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=campus_ai
POSTGRES_USER=campus_ai_runtime
POSTGRES_PASSWORD=change-me-runtime-password
POSTGRES_PORT=5432
# Runtime 必须填写由受控 provisioning 得到的完整数据库身份；占位值只用于提醒，不能用于正式运行。
POSTGRES_EXPECTED_ANCHOR_ID=11111111-1111-4111-8111-111111111111
POSTGRES_EXPECTED_SCHOOL_ID=22222222-2222-4222-8222-222222222222
POSTGRES_EXPECTED_SYSTEM_IDENTIFIER=0000000000000000000
RLS_CONTEXT_SIGNING_KEY=replace-with-the-same-32-byte-random-secret
POSTGRES_POOL_SIZE=4
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_TIMEOUT_SECONDS=3
POSTGRES_POOL_RECYCLE_SECONDS=600

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_READ_TIMEOUT_SECONDS=0.5

# 身份与钉钉（测试、正式环境使用 dingtalk 时填写）
IDENTITY_PROVIDER=local_test
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_IDENTITY_TIMEOUT_SECONDS=5
IDENTITY_SESSION_TTL_SECONDS=28800
IDENTITY_SESSION_COOKIE_NAME=campus_ai_session

# 报修文字整理模型（默认关闭；启用时填写学校当前选择的兼容接口与模型）
REPAIR_DRAFT_MODEL_ENABLED=false
REPAIR_DRAFT_MODEL_SERVICE_NAME=DeepSeek
REPAIR_DRAFT_MODEL_BASE_URL=
REPAIR_DRAFT_MODEL_MODEL=
REPAIR_DRAFT_MODEL_API_KEY=
REPAIR_DRAFT_MODEL_TIMEOUT_SECONDS=10

# MinIO
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=uploads
