      "effective_at": "$reviewed_end_at"
    },
    {
      "generator": "build_correction",
      "base_version": "$after_end.base_version",
      "effective_at": "$reviewed_end_at",
      "requires": "authoritative committed end receipt and effective replacement"
    }
  ]
}
