# 仅受控部署根面使用。复制为 .env.school-fact-role-bootstrap，绝不注入应用或 Writer。
PGHOST=postgres
PGPORT=5432
POSTGRES_DB=campus_ai_internal
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap-password-0001
POSTGRES_RUNTIME_PASSWORD=change-me-runtime-password-0001
POSTGRES_MIGRATION_PASSWORD=change-me-migration-password-0001
POSTGRES_SCHOOL_FACT_WRITER_PASSWORD=change-me-writer-database-password-0001
POSTGRES_SCHOOL_FACT_READER_PASSWORD=change-me-reader-database-password-0001
# 已知集群可填写 pg_control_system().system_identifier；首次空卷初始化时可留空。
POSTGRES_EXPECTED_SYSTEM_IDENTIFIER=
