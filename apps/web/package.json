{
  "name": "campus-ai-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:dingtalk-school-facts": "vue-tsc --noEmit && vite build --config vite.dingtalk-school-facts.config.ts",
    "build:dingtalk-initialization": "vue-tsc --noEmit && vite build --config vite.dingtalk-initialization.config.ts",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "dingtalk-jsapi": "^3.2.9",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
