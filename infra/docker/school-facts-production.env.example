# Public Compose controls only. This is not a runnable configuration.
# Keep all env files, reviewed JSON, TLS, and model key outside Git in separate protected paths.
# Do not copy old identity-test or synthetic database, Redis, Cookie, or model ledger.
CAMPUS_AI_LIVE_PROJECT=campus-ai-school-facts-live
CAMPUS_AI_LIVE_HTTP_PORT=18080
CAMPUS_AI_LIVE_HTTPS_PORT=18443
CAMPUS_AI_LIVE_LOGIN_IP_RATE=5r/s
CAMPUS_AI_LIVE_LOGIN_IP_BURST=30

# Before docker compose config/start, set these to reviewed, private exact values:
# CAMPUS_AI_LIVE_POSTGRES_IMAGE (PostgreSQL 16, pinned digest)
# CAMPUS_AI_LIVE_REDIS_IMAGE (Redis 7, pinned digest)
# CAMPUS_AI_LIVE_API_IMAGE (api.school-fact-live.Dockerfile candidate, pinned digest)
# CAMPUS_AI_LIVE_WEB_IMAGE (web.school-fact-live.Dockerfile candidate, pinned digest)
# CAMPUS_AI_LIVE_POSTGRES_ENV_FILE (only POSTGRES_DB/USER/PASSWORD; new live DB)
# CAMPUS_AI_LIVE_REDIS_ENV_FILE (only REDIS_PASSWORD; new live cache)
# CAMPUS_AI_LIVE_PRODUCT_CONFIG_FILE (reviewed schema56 non-model JSON initially)
# CAMPUS_AI_LIVE_WRITER_CONFIG_FILE (separate reviewed schema56 Writer JSON)
# CAMPUS_AI_LIVE_MODEL_KEY_DIR (private empty directory until model is approved)
# CAMPUS_AI_LIVE_LEDGER_DIR (new private persistent live-only ledger directory)
# CAMPUS_AI_LIVE_TLS_DIR (new live host certificate and key)
# CAMPUS_AI_LIVE_PUBLIC_HOST (reviewed new HTTPS host)

# Web image build requires separately verified real DingTalk Corp/Client IDs;
# they are public client identifiers, but this sample intentionally contains none.
# Use VITE_DINGTALK_CORP_ID and VITE_DINGTALK_CLIENT_ID as build args only after verification.
# Set CAMPUS_AI_ICP_FILING_REQUIRED and VITE_ICP_FILING_NUMBER per actual filing status.
